    </Compile>
    <Compile Update="PanelFunctions\PanelTimer.cs">
      <Link>PanelTimer.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
