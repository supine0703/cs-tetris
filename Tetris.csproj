    </Compile>
    <Compile Update="GameSound.cs">
      <Link>GameSound.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="PanelFunctions\PanelAnimation.cs">
      <Link>PanelAnimation.cs</Link>
