<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>0.2.1.5</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\*\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\iconfont\iconfont.ttf" />
    <EmbeddedResource Include="Assets\font\JetBrainsMono-Regular.ttf" />
    <EmbeddedResource Include="Assets\sound\silent_audio.mp3" />
    <EmbeddedResource Include="Assets\sound\tap-1.mp3" />
    <EmbeddedResource Include="Assets\sound\pop-1.mp3" />
    <EmbeddedResource Include="Assets\sound\pop-2.mp3" />
    <EmbeddedResource Include="Assets\sound\ping-1.mp3" />
    <EmbeddedResource Include="Assets\sound\linging-1.mp3" />
    <EmbeddedResource Include="Assets\sound\fall_to_the_ground-1.mp3" />
    <EmbeddedResource Include="Assets\sound\game_over-1.mp3" />
    <EmbeddedResource Include="Assets\sound\ready_set_go-1.mp3" />
    <EmbeddedResource Include="Assets\music\Korobeiniki(Tetris Theme)-Kutay.mp3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Common\BagRandomizer.cs">
      <Link>BagRandomizer.cs</Link>
    </Compile>
    <Compile Update="Common\Thickness.cs">
      <Link>Thickness.cs</Link>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="PieceDef\PieceData.cs">
      <Link>PieceData.cs</Link>
      <DependentUpon>Piece.cs</DependentUpon>
    </Compile>
    <Compile Update="PieceDef\PieceColor.cs">
      <Link>PieceColor.cs</Link>
      <DependentUpon>Piece.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="BitmapCreator\CreateBlockBitmap.cs">
      <Link>CreateBlockBitmap.cs</Link>
      <DependentUpon>BitmapManager.cs</DependentUpon>
    </Compile>
    <Compile Update="BitmapCreator\CreatePieceBitmap.cs">
      <Link>CreatePieceBitmap.cs</Link>
      <DependentUpon>BitmapManager.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="GameFunctions\GameAnimation.cs">
      <Link>GameAnimation.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameElements.cs">
      <Link>GameElements.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameFrameInvlidate.cs">
      <Link>GameFrameInvlidate.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameKeySystem.cs">
      <Link>GameKeySystem.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GamePaint.cs">
      <Link>GamePaint.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameRecorder.cs">
      <Link>GameRecorder.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameRule.cs">
      <Link>GameRule.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameSetting.cs">
      <Link>GameSetting.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
    <Compile Update="GameFunctions\GameSound.cs">
      <Link>GameSound.cs</Link>
      <DependentUpon>GameControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>