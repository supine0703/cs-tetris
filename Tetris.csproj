<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\*\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\iconfont\iconfont.ttf" />
    <EmbeddedResource Include="Assets\font\JetBrainsMono-Regular.ttf" />
    <EmbeddedResource Include="Assets\sound\tap-1.mp3" />
    <EmbeddedResource Include="Assets\sound\pop-1.mp3" />
    <EmbeddedResource Include="Assets\sound\pop-2.mp3" />
    <EmbeddedResource Include="Assets\sound\ping-1.mp3" />
    <EmbeddedResource Include="Assets\sound\linging-1.mp3" />
    <EmbeddedResource Include="Assets\sound\fall_to_the_ground-1.mp3" />
    <EmbeddedResource Include="Assets\sound\game_over-1.mp3" />
    <EmbeddedResource Include="Assets\music\Korobeiniki(Tetris Theme)-Kutay.mp3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="BlockData.cs">
      <DependentUpon>Block.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelAnimation.cs">
      <Link>PanelAnimation.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelDraw.cs">
      <Link>PanelDraw.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelElements.cs">
      <Link>PanelElements.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelKeySystem.cs">
      <Link>PanelKeySystem.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelRule.cs">
      <Link>PanelRule.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelSettings.cs">
      <Link>PanelSettings.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelSound.cs">
      <Link>PanelSound.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
    <Compile Update="PanelFunctions\PanelTimer.cs">
      <Link>PanelTimer.cs</Link>
      <DependentUpon>Panel.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>